message("==========================================================================")
message("LAUNCHING EMBRC NUMBERED BIBLIOGRAPHIC PIPELINE")
message("==========================================================================")

# ------------------------------------------------------------------------------
# STEP 1: FETCH RAW DATA FROM WEB APIS
# ------------------------------------------------------------------------------
if (file.exists("EMBRC_publications_1_retriever.R")) {
  message("\n>>> STEP 1: Launching retriever (Web API Fetch)...")
  source("EMBRC_publications_1_retriever.R")
} else {
  stop("Critical Error: EMBRC_publications_1_retriever.R not found in the directory.")
}

# ------------------------------------------------------------------------------
# STEP 2: MERGE AND DEDUPLICATE CHUNKS
# ------------------------------------------------------------------------------
if (file.exists("EMBRC_publications_2_merger.R")) {
  message("\n>>> STEP 2: Launching merger (Deduplication & ESFRI Metrics)...")
  source("EMBRC_publications_2_merger.R")
} else {
  stop("Critical Error: EMBRC_publications_2_merger.R not found in the directory.")
}

# ------------------------------------------------------------------------------
# STEP 3: ENRICH WITH NATIVE ALTMETRICS
# ------------------------------------------------------------------------------
if (file.exists("EMBRC_publications_3_altmetrics.R")) {
  message("\n>>> STEP 3: Launching altmetrics (Native Altmetric.com API Query)...")
  source("EMBRC_publications_3_altmetrics.R")
} else {
  stop("Critical Error: EMBRC_publications_3_altmetrics.R not found in the directory.")
}

message("\n==========================================================================")
message("SUCCESS: Full numbered pipeline executed flawlessly!")
message("Your final enriched institutional database is ready.")
message("==========================================================================")
